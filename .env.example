# Folio 환경변수 (요약)
# 전체 목록·설명: docs/env.example
# 로컬: cp docs/env.example .env.local

FOLIO_VERSION=1.3.0
NEXT_PUBLIC_FOLIO_URL=http://localhost:3000

# Discord Embeds (P39)
DISCORD_WEBHOOK_URL=

# GitHub Issues / PR / Actions (P39)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=

# Slack
SLACK_WEBHOOK_URL=

# 기존 MCP Git webhook 시크릿 (GITHUB_WEBHOOK_SECRET 없을 때 fallback)
FOLIO_MCP_WEBHOOK_SECRET=
