# Folio 환경변수 (요약)
# 전체 목록·필수/선택 구분: docs/env.example
# 로컬: cp docs/env.example .env.local

# --- App (선택) ---
FOLIO_VERSION=2.2.0-wip
NEXT_PUBLIC_FOLIO_URL=http://localhost:3000

# --- 저장 관측 (P47, 선택) ---
AUDIT_LOG_RETENTION_DAYS=30
STORAGE_ALERT_THRESHOLD=3

# --- Supabase (클라우드 모드 시 필요 · NEXT_PUBLIC) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Discord Embeds (선택) ---
DISCORD_WEBHOOK_URL=

# --- GitHub Issues / PR / Actions (선택) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=

# --- Slack (선택) ---
SLACK_WEBHOOK_URL=

# --- MCP / Git webhook (선택) ---
FOLIO_MCP_WEBHOOK_SECRET=

# --- 협업 서버 (P48) ---
NEXT_PUBLIC_COLLAB_WS_URL=ws://127.0.0.1:1234
