# Folio — Production 환경변수 템플릿 (P27 · P40)
# 사용법:
#   1) 이 파일을 **참조**해 Vercel → Settings → Environment Variables 에 등록
#      (파일 자체를 Dashboard에 업로드하지 않음 — 값이 소스 오브 트루스)
#   2) Production / Preview 환경을 구분해 등록 (시크릿은 Production 우선)
#   3) 로컬 프로덕션 시뮬레이션: cp .env.production.example .env.production.local
#      (`.env.production.local` 은 gitignore — 커밋 금지)
#   4) GitHub Actions Deploy/Docker/Monitor 는 아래 Secrets도 참고:
#        VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, FOLIO_PRODUCTION_URL
#
# 로컬 개발용 전체 목록: docs/env.example
# 배포 런북: docs/runbooks/DEPLOY.md

# =============================================================================
# 필수 (Production)
# =============================================================================

# 공개 앱 URL (Slack 딥링크 · 푸시 · 절대 URL · Actions 헬스체크)
NEXT_PUBLIC_FOLIO_URL=https://your-domain.com

# Supabase (클라이언트 — Production + Preview 모두 권장)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# 권장
# =============================================================================

# health / runtime 표시 버전 (미설정 시 package.json)
FOLIO_VERSION=2.5.0-wip

# ---------------------------------------------------------------------------
# 성능 관측 (P50, 선택)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PERF_API_SLOW_MS=3000
# NEXT_PUBLIC_PERF_RENDER_SLOW_MS=16
# FOLIO_BUNDLE_BUDGET_MB=8
# FOLIO_CHUNK_BUDGET_KB=500
# BUNDLE_BUDGET_FAIL=1

# 협업 서버 (P48)
# NEXT_PUBLIC_COLLAB_WS_URL=wss://collab.your-domain.com

# 저장 관측 (P47)
AUDIT_LOG_RETENTION_DAYS=30
STORAGE_ALERT_THRESHOLD=3

# MCP / GitHub webhook 시크릿 (P33·P39)
FOLIO_MCP_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=

# =============================================================================
# 선택 — 연동
# =============================================================================

# Jira (서버 전용)
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_DOMAIN=
JIRA_PROJECT_KEY=

# Slack / Discord Incoming Webhook (서버 전용) — Discord는 Embeds(P39)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# GitHub Issues / PR / Actions (P39)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Web Push (P26) — npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-domain.com

# =============================================================================
# 자가호스팅 / Docker · GHCR (Vercel에서는 보통 비움)
# =============================================================================

# BEACON_PROJECT_ROOT=/absolute/path/to/project
# GHCR: ghcr.io/<owner>/folio:latest  (Actions docker.yml)

# =============================================================================
# Supabase Auth URL (대시보드에서 설정 — env가 아님)
# =============================================================================
# Site URL:     https://your-domain.com
# Redirect URLs:
#   https://your-domain.com/**
#   https://*.vercel.app/**

# --- 보안 P49 ---
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=google,github
