# Folio — Production 환경변수 템플릿 (P27)
# 사용법:
#   1) 이 파일을 참고해 Vercel → Settings → Environment Variables 에 등록
#   2) 로컬 프로덕션 시뮬레이션: cp .env.production.example .env.production.local
#      (`.env.production.local` 은 gitignore — 커밋 금지)
#
# 로컬 개발용 전체 목록: docs/env.example
# Vercel: Production / Preview / Development 환경을 구분해 등록한다.

# =============================================================================
# 필수 (Production)
# =============================================================================

# 공개 앱 URL (Slack 딥링크 · 푸시 · 절대 URL)
NEXT_PUBLIC_FOLIO_URL=https://your-domain.com

# Supabase (클라이언트 — Production + Preview 모두 권장)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# 권장
# =============================================================================

# health / runtime 표시 버전 (미설정 시 package.json)
FOLIO_VERSION=1.0.0-wip

# =============================================================================
# 선택 — 연동
# =============================================================================

# Jira (서버 전용)
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_DOMAIN=
JIRA_PROJECT_KEY=

# Slack / Discord Incoming Webhook (서버 전용)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# GitHub Issues (서버 전용)
GITHUB_TOKEN=
GITHUB_REPO=

# Web Push (P26) — npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-domain.com

# =============================================================================
# 자가호스팅 / Docker 전용 (Vercel에서는 보통 비움)
# =============================================================================

# BEACON_PROJECT_ROOT=/absolute/path/to/project

# =============================================================================
# Supabase Auth URL (대시보드에서 설정 — env가 아님)
# =============================================================================
# Site URL:     https://your-domain.com
# Redirect URLs:
#   https://your-domain.com/**
#   https://*.vercel.app/**
