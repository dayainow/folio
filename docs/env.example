# Folio 환경변수 템플릿
# 사용법: 이 파일을 복사해 프로젝트 루트에 `.env.local` 로 저장한 뒤 값을 채운다.
# `.env.local` 은 `.gitignore` 에 포함되어 커밋되지 않는다.
#
# Vercel: Project → Settings → Environment Variables
#   - Production: main 배포
#   - Preview: PR / 기타 브랜치
# Docker Compose: env_file: .env.local (+ 아래 키를 environment로도 전달 가능)

# ---------------------------------------------------------------------------
# App meta (선택)
# ---------------------------------------------------------------------------
FOLIO_VERSION=0.7.0

# ---------------------------------------------------------------------------
# Supabase (클라이언트 — NEXT_PUBLIC_ 필수 · Production + Preview)
# ---------------------------------------------------------------------------
# 프로젝트 Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Jira Cloud (서버 전용 — NEXT_PUBLIC 붙이지 마세요 · Production 권장)
# ---------------------------------------------------------------------------
# Atlassian API 토큰: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token
JIRA_EMAIL=your-email
# 예: mycompany (→ https://mycompany.atlassian.net)
JIRA_DOMAIN=your-domain
JIRA_PROJECT_KEY=PROJ

# ---------------------------------------------------------------------------
# Slack Incoming Webhook (서버 전용, 선택)
# 미설정·placeholder 이면 알림을 조용히 스킵합니다.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=your-slack-webhook-url

# ---------------------------------------------------------------------------
# Discord Incoming Webhook (서버 전용, 선택)
# 미설정·placeholder 이면 알림을 조용히 스킵합니다.
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# ---------------------------------------------------------------------------
# GitHub Issues (서버 전용, 선택)
# 미설정 시 Board의 GitHub 버튼이 숨겨집니다.
# ---------------------------------------------------------------------------
# classic PAT 또는 fine-grained token (issues: read/write)
GITHUB_TOKEN=your-github-token
# owner/name 형식
GITHUB_REPO=owner/repo

# ---------------------------------------------------------------------------
# Beacon 프로세스 (로컬/자가호스팅 — 서버 전용, 선택)
# 미설정 시 process.cwd() 를 프로젝트 루트로 사용합니다.
# Vercel 서버리스에서는 보통 비활성(available=false).
# ---------------------------------------------------------------------------
BEACON_PROJECT_ROOT=/absolute/path/to/project

# ---------------------------------------------------------------------------
# 배포 참고
# ---------------------------------------------------------------------------
# 브랜치 전략:
#   main          → Vercel Production
#   PR / feature/* → Vercel Preview
# Healthcheck:
#   GET /api/health → { status, version, uptime }
# GitHub Actions Deploy (선택):
#   Secrets: VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
