# Folio 환경변수 템플릿
# 사용법: 이 파일을 복사해 프로젝트 루트에 `.env.local` 로 저장한 뒤 값을 채운다.
# `.env.local` 은 `.gitignore` 에 포함되어 커밋되지 않는다.
#
# Vercel: Project → Settings → Environment Variables
#   - Production: main 배포
#   - Preview: PR / 기타 브랜치
# Docker Compose: env_file: .env.local (+ 아래 키를 environment로도 전달 가능)

# ---------------------------------------------------------------------------
# App meta (선택)
# ---------------------------------------------------------------------------
FOLIO_VERSION=3.4.0-wip

# P60 — Supabase Storage 버킷 (Dashboard에서 생성)
# folio-attachments  · 이미지/첨부
# folio-backups      · 자동 백업 JSON

# ---------------------------------------------------------------------------
# 성능 관측 (P50, 선택)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PERF_API_SLOW_MS=3000
# NEXT_PUBLIC_PERF_RENDER_SLOW_MS=16
# FOLIO_BUNDLE_BUDGET_MB=8
# FOLIO_CHUNK_BUDGET_KB=500
# BUNDLE_BUDGET_FAIL=1
# Slack 「확인」 딥링크용 공개 origin (미설정 시 요청 Origin / window)
NEXT_PUBLIC_FOLIO_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 저장 관측 (P47, 선택)
# ---------------------------------------------------------------------------
# 감사 로그 보존 일수 (기본 30) — 클라이언트 localStorage 정리에 사용
AUDIT_LOG_RETENTION_DAYS=30
# 연속 저장 실패 알림 임계 (기본 3) — Slack/Discord/푸시
STORAGE_ALERT_THRESHOLD=3
# (선택) 빌드 타임에 클라이언트로 주입하려면 NEXT_PUBLIC_ 접두사 사용
# NEXT_PUBLIC_AUDIT_LOG_RETENTION_DAYS=30
# NEXT_PUBLIC_STORAGE_ALERT_THRESHOLD=3


# ---------------------------------------------------------------------------
# 협업 서버 (P48, 선택)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_COLLAB_WS_URL=ws://127.0.0.1:1234
# COLLAB_WS_PORT=1234
# COLLAB_WS_HOST=0.0.0.0
# REDIS_URL=

# ---------------------------------------------------------------------------
# 고급 보안 (P49, 선택)
# ---------------------------------------------------------------------------
# OAuth SSO — 콤마 구분 (Supabase Dashboard에서 provider 활성화 필요)
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=google,github
# NEXT_PUBLIC_SAML_ENTITY_ID=

# Web Push (P26, 선택) — npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Supabase (클라이언트 — NEXT_PUBLIC_ 필수 · Production + Preview)
# ---------------------------------------------------------------------------
# 프로젝트 Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Realtime 협업 (P41, 선택)
# ---------------------------------------------------------------------------
# Presence / Yjs 동기화는 NEXT_PUBLIC_SUPABASE_* 가 있으면 Supabase Realtime 사용.
# 미설정 시 BroadcastChannel(같은 브라우저 탭 간) 폴백.
# 주석·활동 클라우드 보관: docs/supabase-schema-collab.sql

# ---------------------------------------------------------------------------
# Jira Cloud (서버 전용 — NEXT_PUBLIC 붙이지 마세요 · Production 권장)
# ---------------------------------------------------------------------------
# Atlassian API 토큰: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token
JIRA_EMAIL=your-email
# 예: mycompany (→ https://mycompany.atlassian.net)
JIRA_DOMAIN=your-domain
JIRA_PROJECT_KEY=PROJ

# ---------------------------------------------------------------------------
# Slack Incoming Webhook (서버 전용, 선택)
# 미설정·placeholder 이면 알림을 조용히 스킵합니다.
# Block Kit 「확인」 링크 버튼은 Incoming Webhook의 url 버튼으로 동작합니다.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=your-slack-webhook-url

# ---------------------------------------------------------------------------
# Discord Incoming Webhook (서버 전용, 선택) — P39 Embeds
# 미설정·placeholder 이면 알림을 조용히 스킵합니다.
# Rich Embed: 저장/태스크 완료/Gate 변경 시 색상·footer·timestamp 포함
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# ---------------------------------------------------------------------------
# GitHub Issues / PR / Actions (서버 전용, 선택) — P39
# 미설정 시 Board의 GitHub 버튼이 숨겨집니다.
# ---------------------------------------------------------------------------
# classic PAT 또는 fine-grained token
#   contents:read, issues:read/write, pull_requests:read, actions:read (선택)
GITHUB_TOKEN=your-github-token
# owner/name 형식
GITHUB_REPO=owner/repo
# GitHub → Folio webhook 서명 검증 (없으면 FOLIO_MCP_WEBHOOK_SECRET 사용)
# Webhook URL: https://your-host/api/github/webhook
# Events: pull_request, issues, workflow_run, ping
GITHUB_WEBHOOK_SECRET=

# GitHub Actions → Folio (repo Secrets)
#   FOLIO_WEBHOOK_URL=https://your-host/api/github/webhook
#   FOLIO_WEBHOOK_SECRET=<위와 동일>

# ---------------------------------------------------------------------------
# Beacon 프로세스 (로컬/자가호스팅 — 서버 전용, 선택)
# 미설정 시 process.cwd() 를 프로젝트 루트로 사용합니다.
# Vercel 서버리스에서는 보통 비활성(available=false).
# ---------------------------------------------------------------------------
BEACON_PROJECT_ROOT=/absolute/path/to/project

# ---------------------------------------------------------------------------
# MCP (P33 — IDE/CLI/Git, 서버 전용)
# ---------------------------------------------------------------------------
# MCP 데이터 루트 (기본: process.cwd())
# FOLIO_MCP_ROOT=/absolute/path/to/folio
# 데이터 디렉터리 (기본: .folio-mcp)
# FOLIO_MCP_DATA_DIR=/absolute/path/to/folio/.folio-mcp
# Git webhook 시크릿 (GitHub Webhook Secret 또는 x-folio-mcp-secret)
FOLIO_MCP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 배포 참고
# ---------------------------------------------------------------------------
# 브랜치 전략:
#   main          → Vercel Production
#   PR / feature/* → Vercel Preview
# Healthcheck:
#   GET /api/health → { status, version, uptime }
# GitHub Actions Deploy (선택):
#   Secrets: VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
