    "runbook:deploy": "node scripts/runbook-deploy.mjs",
    "mcp:server": "tsx src/mcp/stdio.ts",
    "mcp:client": "node scripts/mcp-client.mjs",
    "mcp:link": "node scripts/link-folio-mcp.mjs",
    "collab:server": "tsx src/server/collab/cli.ts",
    "collab:load": "node scripts/collab-load-test.mjs",
    "audit": "npm audit --omit=dev",
    "security:scan": "npm audit --omit=dev --json > .security-audit.json || true; npm audit --omit=dev"
  },
