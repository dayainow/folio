    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "lunr": "^2.3.9",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
